{{!-- A 1200×630 preview image, rendered to PNG at build time. Line breaks and
     the sentence's size are worked out in src/card.ts so it fits. --}}
<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630" font-family="Libre Baskerville">
  <rect width="1200" height="630" fill="#fff"/>
  {{#if date}}
  <text x="72" y="96" font-size="26" fill="#767676">{{didSvg meta.title}}</text>
  <text x="72" y="156" font-size="34" fill="#000">{{date}}{{#if live}}, so far{{/if}}</text>
  {{else}}
  <text x="72" y="156" font-size="34" fill="#000">{{didSvg meta.title}}</text>
  {{/if}}
  {{#each lines}}
  <text x="72" y="{{y}}" font-size="{{../size}}" fill="#000">{{didSvg text}}</text>
  {{/each}}
  {{#if footer}}<text x="72" y="564" font-size="24" fill="#767676">{{footer}}</text>{{/if}}
</svg>
